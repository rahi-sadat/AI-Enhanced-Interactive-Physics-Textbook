{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhysicsScene",
  "description": "Canonical Schema v1 for book-agnostic interactive physics simulations with parameter provenance.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "domain",
    "type",
    "parameters"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "id": {
      "type": "string",
      "description": "Unique identifier for the figure or simulation (e.g. PHY-FIG-001)"
    },
    "domain": {
      "type": "string",
      "enum": ["mechanics", "optics", "circuits"],
      "description": "Physics domain category"
    },
    "type": {
      "type": "string",
      "description": "Specific simulation scenario type (e.g. pendulum, projectile, thin_lens, mirror, series_parallel)"
    },
    "title": {
      "type": "string",
      "description": "Human-readable scenario title"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the scenario and educational concept"
    },
    "source": {
      "type": "object",
      "description": "Origin of the figure (textbook scan, upload, lab figure)",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["book_figure", "upload", "synthetic", "interactive_lab"]
        },
        "image": {
          "type": "string",
          "description": "Path or URL to the reference textbook diagram image"
        },
        "page": {
          "type": "integer"
        },
        "book": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "description": "Authoritative coordinate space definition",
      "properties": {
        "width": {
          "type": "number",
          "default": 800
        },
        "height": {
          "type": "number",
          "default": 600
        },
        "unit": {
          "type": "string",
          "default": "source-pixel"
        },
        "pixelsPerUnit": {
          "type": "number",
          "default": 1.0
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "Simulation parameters with evidentiary provenance",
      "additionalProperties": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": {
            "type": ["number", "string", "boolean"]
          },
          "unit": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          },
          "provenance": {
            "type": "string",
            "enum": [
              "observed",
              "assumed",
              "inferred",
              "author_override",
              "default",
              "student"
            ],
            "description": "Evidentiary classification of where this parameter value originated"
          },
          "source": {
            "type": "string",
            "description": "Description of the evidentiary source (e.g. surrounding_text, diagram_label, earth_default)"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Confidence score of extraction or inference (0.0 to 1.0)"
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "description": "Domain-specific geometric layout and landmarks in source pixels"
    },
    "objects": {
      "type": "array",
      "description": "List of physical, optical, or electrical entities in the simulation"
    },
    "visual": {
      "type": "object",
      "description": "Visual presentation overrides and background assets"
    },
    "metadata": {
      "type": "object",
      "description": "Educational metadata, curriculum tags, and chapter links"
    }
  }
}
