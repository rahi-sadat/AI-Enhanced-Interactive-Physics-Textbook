{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhysicsScene",
  "description": "Canonical Schema v1 for book-agnostic interactive physics simulations with parameter provenance.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "domain",
    "subtype",
    "coordinateSpace",
    "parameters"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "id": {
      "type": "string",
      "description": "Unique identifier for the figure or simulation (e.g. PHY-FIG-001)"
    },
    "domain": {
      "type": "string",
      "enum": ["mechanics", "optics", "circuits"],
      "description": "Physics domain category"
    },
    "subtype": {
      "type": "string",
      "description": "Canonical scenario subtype (e.g. pendulum, projectile, thin_lens, spherical_mirror, interface_refraction, prism, dc)"
    },
    "type": {
      "type": "string",
      "description": "Legacy alias for subtype"
    },
    "title": {
      "type": "string",
      "description": "Human-readable scenario title"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the scenario and educational concept"
    },
    "source": {
      "type": "object",
      "description": "Origin of the figure (textbook scan, upload, lab figure)",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["book_figure", "upload", "synthetic", "interactive_lab", "text_scenario"]
        },
        "image": {
          "type": "string",
          "description": "Path or URL to reference diagram image"
        },
        "page": {
          "type": "integer"
        },
        "book": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "coordinateSpace": {
      "description": "Authoritative coordinate space definition (discriminated union: source_px, world, local)",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "width", "height"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["source_px"]
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "unit"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["world"]
            },
            "unit": {
              "type": "string"
            },
            "bounds": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "width", "height"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["local"]
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        }
      ]
    },
    "coordinateSystem": {
      "type": "object",
      "description": "Legacy alias for coordinateSpace",
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "pixelsPerUnit": {
          "type": "number"
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "Simulation parameters with evidentiary provenance",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": ["number", "string", "boolean", "null"]
          },
          "status": {
            "type": "string",
            "enum": ["known", "symbolic", "unknown"]
          },
          "unit": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "editable": {
            "type": "boolean"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          },
          "provenance": {
            "type": "string",
            "enum": [
              "observed",
              "assumed",
              "inferred",
              "author_override",
              "default",
              "student",
              "teacher",
              "detected",
              "derived",
              "system",
              "user"
            ],
            "description": "Evidentiary classification of where this parameter value originated"
          },
          "source": {
            "type": "string",
            "description": "Description of the evidentiary source"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "control": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["slider", "number", "toggle", "select"]
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              },
              "options": {
                "type": "array"
              }
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "description": "Physical environment specifications (gravity, ambient medium)"
    },
    "geometry": {
      "type": "object",
      "description": "Geometric layout and landmarks"
    },
    "objects": {
      "type": "array",
      "description": "Physical or optical entities"
    },
    "circuit": {
      "type": "object",
      "description": "Circuit graph specification for electrical domain"
    },
    "visual": {
      "type": "object",
      "description": "Visual presentation overrides"
    },
    "metadata": {
      "type": "object",
      "description": "Curriculum links, textbook chapter, and authoring metadata"
    }
  }
}
