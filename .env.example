# Environment Configuration for AugmentedPhysics
# Copy this file to .env and provide your API keys. Never commit .env with real secrets.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Use only the local circuit detector for diagram uploads.
CIRCUIT_V2_ONLY=false
# Optional local checkpoint override. Defaults to v2 weights/last.pt.
CIRCUIT_V2_CHECKPOINT=
